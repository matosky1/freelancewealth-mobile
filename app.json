      "bundleIdentifier": "com.freelancewealth.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1A1612"
      },
      "package": "com.freelancewealth.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "a0a10c37-4105-4f93-aba9-20a9eb08cfc2"
      }
    },
    "owner": "matosky"
  }
}
